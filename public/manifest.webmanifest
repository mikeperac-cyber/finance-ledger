{
  "id": "com.equinox.ledger",
  "name": "Equinox Ledger — Multi-Currency Financial Engine",
  "short_name": "Equinox Ledger",
  "description": "Local-first multi-currency personal & solo-business financial ledger with life-hours opportunity cost, reverse budgeting, and tax reserve firewalls.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0c0d0f",
  "theme_color": "#0c0d0f",
  "categories": ["finance", "productivity", "business"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
